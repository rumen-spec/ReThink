{
  "name": "rethink",
  "private": true,
  "description": "ReThink \u2014 budget-aware shopping across Chrome and iOS (HackWestern 13)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test --workspace=packages/shared",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "mobile": "npm run start --workspace=apps/mobile",
    "extension": "npm run dev --workspace=apps/extension",
    "extension:build": "npm run build --workspace=apps/extension",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push --remote --include-seed",
    "db:functions": "supabase functions serve --env-file supabase/functions/.env",
    "functions:deploy": "supabase functions deploy --use-api --no-verify-jwt --import-map supabase/functions/deno.json"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "supabase": "^3.2.0"
  }
}
