{
  "name": "rethink",
  "private": true,
  "description": "ReThink — budget-aware shopping across Chrome and iOS (HackWestern 13)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test --workspace=packages/shared",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "mobile": "npm run start --workspace=apps/mobile",
    "extension": "npm run dev --workspace=apps/extension",
    "extension:build": "npm run build --workspace=apps/extension",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:functions": "supabase functions serve --env-file supabase/functions/.env"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "supabase": "^3.2.0"
  }
}
