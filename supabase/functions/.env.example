# SERVER-ONLY secrets. Never copy these into apps/mobile or apps/extension.
# Local: `supabase functions serve --env-file supabase/functions/.env`
# Hosted: `supabase secrets set --env-file supabase/functions/.env`
GEMINI_API_KEY=
# Optional: Expo access token for push if the project enforces it.
EXPO_ACCESS_TOKEN=
